{
  "name": "newco-funding-form",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tailwindcss -i src/index.css -o src/compiled.css --watch\" \"vite\"",
    "prebuild": "tailwindcss -i src/index.css -o src/compiled.css --minify",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "webflow:share": "tailwindcss -i src/index.css -o src/compiled.css --minify && webflow library share --no-input"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@sentry/react": "^10.54.0",
    "@tabler/icons-react": "^3.19.0",
    "@webflow/data-types": "latest",
    "@webflow/react": "latest",
    "posthog-js": "^1.376.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-imask": "^7.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@webflow/webflow-cli": "latest",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
